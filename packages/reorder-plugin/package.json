{
    "name": "@vendure/reorder-plugin",
    "version": "3.7.0",
    "license": "GPL-3.0-or-later",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "lib/**/*",
        "i18n/**/*"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/vendurehq/vendure"
    },
    "scripts": {
        "watch": "tsc -p ./tsconfig.build.json --watch",
        "build": "rimraf lib && tsc -p ./tsconfig.build.json",
        "lint": "eslint --fix .",
        "test": "vitest --config vitest.config.mts --run",
        "e2e": "cross-env PACKAGE=reorder-plugin vitest --config ../../e2e-common/vitest.config.mts --run",
        "bench": "cross-env PACKAGE=reorder-plugin vitest --config ../../e2e-common/vitest.config.bench.ts --run",
        "ci": "npm run build",
        "typecheck:error-code-exhaustive": "node ../../node_modules/typescript/bin/tsc -p ./e2e/tsconfig.error-code-exhaustive.json --noEmit",
        "typecheck:error-code-defaulted": "node ../../node_modules/typescript/bin/tsc -p ./e2e/tsconfig.error-code-defaulted.json --noEmit"
    },
    "homepage": "https://www.vendure.io/",
    "funding": "https://github.com/sponsors/michaelbromley",
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@vendure/common": "3.7.0",
        "@vendure/core": "3.7.0"
    }
}
