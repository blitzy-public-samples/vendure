{
    "name": "@vendure/seller-scoring-plugin",
    "version": "3.7.0",
    "license": "GPL-3.0-or-later",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "lib/**/*"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/vendurehq/vendure"
    },
    "scripts": {
        "watch": "tsc -p ./tsconfig.build.json --watch",
        "build": "rimraf lib && tsc -p ./tsconfig.build.json && node ./build/copy-dashboard.mjs",
        "lint": "eslint --fix .",
        "test": "vitest --config vitest.config.mts --run",
        "e2e": "cross-env PACKAGE=seller-scoring-plugin vitest --config ../../e2e-common/vitest.config.mts --run",
        "e2e:watch": "cross-env PACKAGE=seller-scoring-plugin vitest --config ../../e2e-common/vitest.config.mts",
        "bench": "cross-env PACKAGE=seller-scoring-plugin vitest --config ../../e2e-common/vitest.config.bench.ts --run"
    },
    "homepage": "https://www.vendure.io/",
    "funding": "https://github.com/sponsors/michaelbromley",
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@vendure/common": "3.7.0",
        "@vendure/core": "3.7.0",
        "@vendure/dashboard": "3.7.0",
        "@vendure/testing": "3.7.0",
        "@vitest/coverage-v8": "^3.2.4",
        "rimraf": "^5.0.5",
        "typescript": "5.8.2"
    }
}
